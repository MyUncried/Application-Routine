{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MyUncried/Application-Routine/.github/orchestration/slice-manifest.schema.json",
  "title": "KODJO slice manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "slice_id", "title", "status", "repository", "issue_number", "target_branch", "baseline_head", "previous_slice", "sources", "scope", "gates", "sessions"],
  "properties": {
    "schema": {"const": "kodjo.slice.v1"},
    "slice_id": {"type": "string", "pattern": "^T[0-9]{2}-S[0-9]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["WAITING_FOR_PREVIOUS_SLICE", "AWAITING_SLICE_SPEC", "SPEC_PREPARED", "PLAN_BUILDING", "PLAN_REVIEW", "PLAN_USER_GATE", "IMPLEMENTING", "IMPLEMENTATION_REVIEW", "VISUAL_USER_GATE", "FINALIZING", "CLARIFICATION_REQUIRED", "USAGE_LIMIT", "ORCHESTRATION_FAILURE", "DONE"]},
    "repository": {"const": "MyUncried/Application-Routine"},
    "issue_number": {"type": ["integer", "null"], "minimum": 1},
    "target_branch": {"type": "string", "minLength": 1},
    "baseline_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "previous_slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice_id", "issue_number", "required_status", "final_head"],
      "properties": {
        "slice_id": {"type": "string", "pattern": "^T[0-9]{2}-S[0-9]{2}$"},
        "issue_number": {"type": "integer", "minimum": 1},
        "required_status": {"const": "DONE"},
        "final_head": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "in_scope", "out_of_scope", "acceptance_criteria"],
      "properties": {
        "objective": {"type": "string"},
        "in_scope": {"type": "array", "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}},
        "acceptance_criteria": {"type": "array", "items": {"type": "string"}}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_user_approval", "technical_review", "visual_user_approval", "final_checks"],
      "properties": {
        "plan_user_approval": {"type": "boolean"},
        "technical_review": {"type": "boolean"},
        "visual_user_approval": {"type": "boolean"},
        "final_checks": {"type": "boolean"}
      }
    },
    "sessions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review", "development"],
      "properties": {
        "review": {"type": ["string", "null"], "pattern": "^[0-9a-f-]{36}$"},
        "development": {"type": ["string", "null"], "pattern": "^[0-9a-f-]{36}$"}
      }
    }
  }
}
