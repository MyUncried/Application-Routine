{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kodjo.protocol.v2.slice-bootstrap.0.6.12",
  "title": "KODJO V2 SliceBootstrapIdentity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slice_id",
    "issue_number",
    "repository",
    "target_branch",
    "baseline_head",
    "protocol_version",
    "protocol_commit",
    "activation_registry",
    "previous_slice_id",
    "previous_checkpoint",
    "product_sources",
    "authorized_actors",
    "created_at",
    "slice_bootstrap_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "kodjo.protocol.v2.slice-bootstrap.0.6.12"
    },
    "slice_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,80}$"
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "target_branch": {
      "type": "string",
      "minLength": 1
    },
    "baseline_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "protocol_version": {
      "const": "0.6.12"
    },
    "protocol_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "activation_registry": {
      "const": ".github/orchestration/v2-activation-registry.json"
    },
    "previous_slice_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_checkpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "product_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "authorized_actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "slice_bootstrap_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "planning_application_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
